---
import BaseLayout from '../layouts/BaseLayout.astro';

const skills = [
  { icon: '🧠', name: 'GenAI & Agentic Platforms' },
  { icon: '🏭', name: 'Self-Hosted AI Workloads' },
  { icon: '🤖', name: 'Integrated Agentic Systems' },
  { icon: '⚡', name: 'Distributed Inference' },
  { icon: '⎈', name: 'Kubernetes & Amazon EKS' },
  { icon: '📦', name: 'Amazon ECS & Fargate' },
  { icon: 'λ', name: 'AWS Lambda' },
  { icon: '🦎', name: 'Bottlerocket OS' },
  { icon: '🔒', name: 'Container Security' },
  { icon: '🌐', name: 'Container Networking' },

];

const certifications = [
  {
    name: 'NVIDIA-Certified Associate: AI Infrastructure and Operations',
    issuer: 'NVIDIA',
    url: 'https://www.credly.com/badges/bbf9d17d-4445-4ed2-aadb-10d105c82a62/linked_in?t=tevmzh',
    icon: '🟩',
  },
  {
    name: 'AWS Certified AI Practitioner',
    issuer: 'Amazon Web Services',
    url: 'https://www.credly.com/badges/f3db6890-6c8f-4179-8b55-8925e66eb8fb/public_url',
    icon: '🟧',
  },
];

---

<BaseLayout title="About">
  <div class="container">
    <div class="page-header">
      <h1>About Me 👋</h1>
      <p>A bit about who I am and what I do</p>
    </div>

    <div class="about-grid">
      <div class="about-intro">
        <p>
          I'm a <strong>Sr. Specialist Solutions Architect</strong> on the <strong>AWS GenAI &amp; Agentic Platforms</strong> team, focused on helping customers design production AI workloads across self-hosted and integrated architectures.
        </p>
        <p>
          My work spans self-hosted AI workloads on orchestrators such as <strong>Amazon EKS</strong>, <strong>Amazon ECS</strong>, and <strong>AWS Lambda</strong>, and integrated agentic systems that use frontier models, managed memory, gateways, identity, and sandboxed execution environments.
        </p>
        <p>
          Before this role, I spent three years as a Specialist SA for AWS Container Services, helping customers design secure, scalable cloud-native architectures across EKS, ECS, Fargate, Karpenter, Bottlerocket, and related platforms. I also write and speak publicly through AWS blogs, workshops, <strong>KubeCon + CloudNativeCon</strong>, <strong>AWS re:Invent</strong>, and <strong>AWS re:Inforce</strong>.
        </p>

      </div>

      <div class="about-section">
        <h2>🛠️ Areas of Expertise</h2>
        <div class="skill-grid">
          {skills.map((skill) => (
            <div class="skill-card">
              <span class="skill-icon">{skill.icon}</span>
              <span class="skill-name">{skill.name}</span>
            </div>
          ))}
        </div>
      </div>

      <div class="about-section">
        <h2>🎓 Certifications</h2>
        <div class="skill-grid">
          {certifications.map((cert) => (
            <a href={cert.url} target="_blank" rel="noopener noreferrer" class="skill-card cert-card">
              <span class="skill-icon">{cert.icon}</span>
              <span class="cert-text">
                <span class="skill-name">{cert.name}</span>
                <span class="cert-issuer">{cert.issuer}</span>
              </span>
            </a>
          ))}
        </div>
      </div>


    </div>
  </div>
</BaseLayout>

<style is:global>
  .cert-card {
    text-decoration: none;
    color: inherit;
  }
  .cert-card:hover .skill-name { color: var(--accent-light); }
  .cert-text {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }
  .cert-issuer {
    font-size: 0.75rem;
    color: var(--text-secondary);
    font-weight: 500;
  }
</style>
