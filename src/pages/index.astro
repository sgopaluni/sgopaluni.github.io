---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
  <section class="hero">
    <div class="container">
      <div class="hero-badge">
        <span class="dot"></span>
        Sr. Specialist SA, GenAI &amp; Agentic Platforms @ AWS
      </div>
      <h1>
        Hi, I'm <span class="gradient">Sai Charan Teja</span>
      </h1>
      <p class="hero-subtitle">I help customers design production GenAI and agentic platforms across self-hosted cloud-native runtimes and integrated frontier-model architectures.</p>
      <div class="hero-actions">
        <a href="/blogs/" class="btn btn-primary">📝 Read my Blogs</a>
        <a href="/talks/" class="btn btn-ghost">🎤 Watch my Talks</a>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card" style="--card-accent: var(--cyan);">
          <div class="feature-icon" style="--icon-bg: rgba(6, 182, 212, 0.15);">☁️</div>
          <h3>Production GenAI Workloads</h3>
          <p>Self-hosted AI workloads on EKS, ECS, and Lambda, with deep attention to inference, latency, cost, security, and operational reliability. 🚀</p>
        </div>
        <div class="feature-card" style="--card-accent: var(--pink);">
          <div class="feature-icon" style="--icon-bg: rgba(236, 72, 153, 0.15);">💡</div>
          <h3>Agentic Architectures</h3>
          <p>Integrated agentic systems using frontier models, managed memory, gateways, identity, and sandboxed execution environments. 📚</p>
        </div>
        <div class="feature-card" style="--card-accent: var(--green);">
          <div class="feature-icon" style="--icon-bg: rgba(34, 197, 94, 0.15);">🎯</div>
          <h3>Cloud-Native AI Infrastructure</h3>
          <p>A containers and orchestration foundation across Kubernetes, EKS, ECS, Fargate, Karpenter, Bottlerocket, and secure platform patterns. 🔒</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
